# Configuration d'éditeur commune au monorepo Limpid.
# Voir https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 80

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,webp,pdf,zip,gz,woff,woff2,ttf,otf,exe,dll}]
insert_final_newline = false
trim_trailing_whitespace = false
