# Exemple de configuration de l'API Limpid.
#
# Ce fichier est un MODÈLE : il ne contient aucun secret et n'est jamais
# utilisé tel quel. Copiez-le en `.env` et renseignez vos propres valeurs.
# Le fichier `.env` est ignoré par git.
#
#   cp .env.example .env
#
# En développement, l'API démarre sans aucune de ces variables : le profil
# `dev` remplace les services distants par des valeurs de substitution
# explicites, et les routes qui exigent le vrai service répondent une erreur
# propre. Voir docs/DEVELOPMENT.md §3.2 et la décision D-29.

# ─── Profil ──────────────────────────────────────────────────────────────────
#
# dev   : les services distants sont facultatifs (défaut).
# prod  : toutes les variables obligatoires, le serveur refuse de démarrer
#         si l'une manque.
LIMPID_PROFILE=dev

# ─── Base de données ────────────────────────────────────────────────────────
#
# sqlite   : fichier local, migrations de db/migrations/sqlite (défaut).
# postgres : serveur PostgreSQL, migrations de db/migrations.
LIMPID_DB_DRIVER=sqlite
LIMPID_DB_PATH=.limpid/limpid.db

# Requis uniquement quand LIMPID_DB_DRIVER=postgres.
# DATABASE_URL=postgres://utilisateur:mot_de_passe@hote:5432/limpid

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_BYTES=4194304

# ─── Pagination ─────────────────────────────────────────────────────────────
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=200
MAX_OPERATIONS_PER_BATCH=200

# ─── Purge des comptes (RGPD, D-19) ─────────────────────────────────────────
#
# Délai entre deux passages du worker qui efface les comptes dont la
# demande de suppression a atteint son échéance (trente jours).
LIMPID_PURGE_INTERVAL_SECONDS=3600

# ─── Authentification (Supabase) ────────────────────────────────────────────
#
# SUPABASE_JWKS_URL est calculé à partir de SUPABASE_URL quand il est absent.
# SUPABASE_URL=https://<projet>.supabase.co
# SUPABASE_ANON_KEY=<clé publiable>
# SUPABASE_JWKS_URL=https://<projet>.supabase.co/auth/v1/.well-known/jwks.json

# ─── Cache et files d'attente ───────────────────────────────────────────────
#
# REDIS_URL=redis://localhost:6379

# ─── Stockage des fichiers (Cloudflare R2) ──────────────────────────────────
#
# R2_ACCOUNT_ID=<identifiant du compte>
# R2_ENDPOINT=https://<identifiant>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<clé d'accès>
# R2_SECRET_ACCESS_KEY=<clé secrète>
# R2_BUCKET=limpid-exports

# ─── IA ─────────────────────────────────────────────────────────────────────
#
# ANTHROPIC_API_KEY=<clé Anthropic>
AI_RATE_LIMIT_CAPACITY=10
AI_RATE_LIMIT_REFILL_PER_SECOND=0.5
JWKS_CACHE_TTL=900

# ─── Paiement (Stripe) ──────────────────────────────────────────────────────
#
# STRIPE_SECRET_KEY=<clé secrète Stripe>

# Secret de signature du point de rappel Stripe. Facultatif : sans lui,
# l'API refuse proprement les livraisons du webhook au lieu de refuser de
# démarrer. On le trouve dans le tableau de bord Stripe, dans les détails du
# point de rappel.
# STRIPE_WEBHOOK_SECRET=<secret de signature whsec_…>

# Identifiants des événements Stripe que le webhook traite, séparés par des
# virgules. Facultatif : absent, le webhook traite la confirmation d'un
# paiement, le changement de formule et l'annulation.
# STRIPE_WEBHOOK_EVENTS=checkout.session.completed,customer.subscription.updated,customer.subscription.deleted

# ─── Distribution Amazon KDP ───────────────────────────────────────────────
#
# Les trois identifiants du compte développeur Amazon (App de Selling Partner
# API). Facultatifs : sans eux, l'API prépare un dossier de dépôt et refuse
# le dépôt en disant pourquoi — elle ne prétend jamais que le livre est
# arrivé chez Amazon.
# AMAZON_KDP_CLIENT_ID=<identifiant du client>
# AMAZON_KDP_CLIENT_SECRET=<secret du client>
# AMAZON_KDP_REFRESH_TOKEN=<jeton de renouvellement>
