# ─── Dart / Flutter ──────────────────────────────────────────────────────────

# Tooling state and resolved package configuration.
.dart_tool/
.packages
.pub-cache/
.pub/

# Build artefacts of every package and application.
build/
.flutter-plugins
.flutter-plugins-dependencies

# Localisations generated by `flutter gen-l10n`. The ARB files are the source
# and they are versioned; the generated Dart is rebuilt by the toolchain.
apps/**/lib/l10n/generated/
packages/**/lib/l10n/generated/

# Lock files.
#
# Dart rule: a library package does not commit its lock file, an application
# does. The applications therefore keep their own committed lock, and the
# library packages that already own one keep it as well: it is the state
# their test suites are green against, and it is removed only when those
# packages opt into the Dart pub workspace (see docs/DEVELOPMENT.md).
#
# A library package that has no lock file yet follows the standard Dart rule
# and does not commit one.
pubspec.lock
!apps/**/pubspec.lock
!packages/limpid_core/pubspec.lock
!packages/limpid_design_system/pubspec.lock
!packages/limpid_ai/pubspec.lock
!packages/limpid_export/pubspec.lock
!packages/limpid_sync/pubspec.lock
!packages/limpid_quill/pubspec.lock

# ─── Local database ─────────────────────────────────────────────────────────
#
# The SQLite file of the development API (D-29). It is a local artefact, never
# a source: it is recreated from the migrations at every start.
.limpid/
*.sqlite
*.sqlite3
*.db

# Written by `melos bootstrap` to resolve the path dependencies locally.
pubspec_overrides.yaml

# Legacy package configuration file.
tool/.packages

# ─── Tests and coverage ─────────────────────────────────────────────────────

coverage/
lcov.info

# ─── Secrets ────────────────────────────────────────────────────────────────

.env
.env.*
!.env.example

# ─── Logs and temporary files ───────────────────────────────────────────────

*.log
*.pid
*.tmp
*.bak
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDEs ───────────────────────────────────────────────────────────────────

*.iml
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ─── macOS ──────────────────────────────────────────────────────────────────

.DS_Store
.AppleDouble
.LSOverride
# Le fichier `Icon` de macOS porte un retour chariot final. Le motif doit
# refuser les lettres : sans cela, sur un systeme de fichiers insensible a
# la casse, il attrapait aussi le dossier `icons/` du design system, et le
# fichier d icones n etait pas versionne.
Icon[^a-zA-Z]

# ─── Mockups ────────────────────────────────────────────────────────────────

mockups/.edgeprof/
mockups/.chrprof/
mockups/node_modules/
mockups/.cache/
